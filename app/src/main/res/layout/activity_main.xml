<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hindi Story TTS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Hindi Voice:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Voice Selection Option -->
    <RadioGroup
        android:id="@+id/radioGroupVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioMadhur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Madhur (Male)"
            android:checked="true"
            android:layout_marginEnd="16dp"/>

        <RadioButton
            android:id="@+id/radioSwara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swara (Female)"/>
    </RadioGroup>

    <!-- Story Text Input -->
    <EditText
        android:id="@+id/editStoryText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="Paste your Hindi story text here..."
        android:inputType="textMultiLine"
        android:background="#11000000"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play Story"
        android:padding="16dp"/>
</LinearLayout>
