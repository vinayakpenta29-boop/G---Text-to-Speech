<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hindi Story TTS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Voice Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Hindi Voice:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/radioGroupVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioMadhur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Madhur (Male)"
                android:checked="true"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/radioSwara"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swara (Female)"/>
        </RadioGroup>

        <!-- Speed Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Speed:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/radioGroupSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/speed075"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.75x"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/speed100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:checked="true"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/speed125"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.25x"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/speed150"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5x"/>
        </RadioGroup>

        <!-- Pitch Selection (Horror Effects) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Pitch (Horror FX):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/radioGroupPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/pitchNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Normal"
                android:checked="true"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/pitchDeep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deep"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/pitchDemon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demon"/>
        </RadioGroup>

        <!-- Live Pitch SeekBar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fine-tune:"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <SeekBar
                android:id="@+id/seekBarPitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"/>

            <TextView
                android:id="@+id/txtPitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Story Text Input -->
        <EditText
            android:id="@+id/editStoryText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="140dp"
            android:gravity="top|start"
            android:hint="Paste your Hindi story text here..."
            android:inputType="textMultiLine"
            android:background="#11000000"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Generate & Play Button -->
        <Button
            android:id="@+id/btnGeneratePlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate &amp; Play"
            android:padding="14dp"
            android:layout_marginBottom="8dp"/>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnPauseResume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pause"
                android:enabled="false"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop"
                android:enabled="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
